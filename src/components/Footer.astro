---
/**
 * Pie del sitio.
 *
 * Los datos legales que faltan se muestran marcados como PENDIENTE a
 * proposito: es preferible que se vean a que se publiquen inventados. Ver
 * PENDIENTES.md.
 */
import config from "../datos/config.json";
import categorias from "../datos/categorias.json";
import Icono from "./Icono.astro";
import Logo from "./Logo.astro";

const base = import.meta.env.BASE_URL;
const enlace = (ruta: string) => `${base}${ruta}`.replace(/\/{2,}/g, "/");
const anio = new Date().getFullYear();
const falta = (valor: string) => valor === "PENDIENTE";
---

<footer class="pie">
  <div class="container pie-grid">
    <div class="pie-col pie-marca">
      <Logo alto={48} />
      <p class="pie-tagline">{config.tagline}</p>
      <p class="pie-descripcion">{config.descripcion_corta}</p>
      <a class="pie-wa" href={`https://wa.me/${config.whatsapp}`} target="_blank" rel="noopener">
        <Icono nombre="whatsapp" tamano={18} />
        {config.whatsapp_visible}
      </a>
      <p class="pie-redes">
        {config.redes.map((red) => red.url ? (
          <a class="pie-red" href={red.url} target="_blank" rel="noopener" aria-label={red.nombre}>
            <Icono nombre={red.id} tamano={18} />
          </a>
        ) : (
          <span class="pie-red pie-red-apagada" role="img" title={red.nombre} aria-label={red.nombre}>
            <Icono nombre={red.id} tamano={18} />
          </span>
        ))}
      </p>
    </div>

    <div class="pie-col">
      <h3 class="pie-titulo">Categorías</h3>
      <ul class="pie-lista">
        {categorias.map((c) => (
          <li><a href={enlace(`categoria/${c.id}`)}>{c.nombre}</a></li>
        ))}
      </ul>
    </div>

    <div class="pie-col">
      <h3 class="pie-titulo">La droguería</h3>
      <ul class="pie-lista">
        <li><a href={enlace("nosotros")}>Nosotros</a></li>
        <li><a href={enlace("servicios")}>Servicios</a></li>
        <li><a href={enlace("sedes")}>Sedes</a></li>
        <li><a href={enlace("contacto")}>Contacto</a></li>
      </ul>
    </div>

    <div class="pie-col">
      <h3 class="pie-titulo">Nuestras sedes</h3>
      <ul class="pie-lista pie-sedes">
        {config.sedes.map((sede) => (
          <li>
            <strong>{sede.nombre}</strong>
            <span>{sede.direccion}</span>
            <a href={`tel:${sede.telefono}`}>{sede.telefono_visible}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="pie-legal">
    <div class="container">
      <p class="pie-aviso">
        Los medicamentos que requieren fórmula médica se entregan únicamente con la fórmula
        vigente. Droguería Xivica no comercializa medicamentos de control especial. Este sitio
        no reemplaza la consulta con un profesional de la salud. Más información en la{" "}
        <a href="https://www.saludcapital.gov.co" target="_blank" rel="noopener">
          Secretaría de Salud de Bogotá
        </a>. Comunicaciones: <a href={`mailto:${config.correo}`}>{config.correo}</a>.
      </p>
      <div class="pie-ultima">
        <span>
          © {anio} {config.negocio}. Todos los derechos reservados.
          {!falta(config.legal.nit) && <> NIT {config.legal.nit}.</>}
        </span>
        <nav class="pie-legales" aria-label="Enlaces legales">
          <a href={enlace("legal/privacidad")}>Privacidad</a>
          <a href={enlace("legal/datos")}>Tratamiento de datos</a>
          <a href={enlace("legal/terminos")}>Términos</a>
          <a href={enlace("legal/domicilios")}>Domicilios</a>
        </nav>
        <span>
          {config.creditos.texto}{" "}
          {config.creditos.url ? (
            <a href={config.creditos.url} target="_blank" rel="noopener">{config.creditos.nombre}</a>
          ) : (
            <span>{config.creditos.nombre}</span>
          )}.
        </span>
      </div>
    </div>
  </div>
</footer>
