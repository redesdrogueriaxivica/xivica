---
import Tienda from "../layouts/Tienda.astro";
import Icono from "../components/Icono.astro";
import Foto from "../components/Foto.astro";
import config from "../datos/config.json";

const falta = (v: string) => v === "PENDIENTE";
---
<Tienda
  titulo="Nuestras sedes"
  descripcion={`Droguería Xivica tiene ${config.sedes.length} sedes en el norte de Bogotá. Dirección, teléfono y cómo llegar.`}
  activa="sedes"
>
  <div class="container">
    <header class="catalogo-cabeza">
      <h1>Nuestras sedes</h1>
      <p>{config.sedes.length} puntos en el norte de {config.ciudad}. Puedes recoger tu pedido en cualquiera.</p>
    </header>

    <div class="sedes">
      {config.sedes.map((sede) => (
        <article class="sede">
          {sede.foto ? (
            <figure class="sede-foto">
              <Foto nombre={sede.foto} alt={sede.foto_alt} sizes="(max-width: 700px) 92vw, 420px" />
            </figure>
          ) : (
            // Marcador honesto: esta sede aun no tiene foto. Ver PENDIENTES.md.
            <div class="sede-foto sede-foto-vacia" role="img" aria-label={`Foto de la sede ${sede.nombre} pendiente`}>
              <Icono nombre="tienda" tamano={30} grosor={1.5} />
              <span>Foto de la sede próximamente</span>
            </div>
          )}
          <h2>{sede.nombre}</h2>
          <p class="sede-dato"><Icono nombre="ubicacion" tamano={17} /> {sede.direccion}</p>
          <p class="sede-dato"><Icono nombre="telefono" tamano={17} /> <a href={`tel:${sede.telefono}`}>{sede.telefono_visible}</a></p>
          <p class="sede-dato sede-horario">
            <Icono nombre="reloj" tamano={17} />
            {falta(sede.horario_semana) ? (
              <mark class="falta">Falta el horario de atención</mark>
            ) : (
              <span>
                {sede.horario_semana}
                <br />
                {sede.horario_festivos}
              </span>
            )}
          </p>
          <div class="sede-acciones">
            <button type="button" class="boton boton-borde" data-ver-sede={sede.id}>Ver en el mapa</button>
            <a class="boton boton-azul" target="_blank" rel="noopener"
               href={`https://www.google.com/maps/search/?api=1&query=${sede.lat},${sede.lng}`}>Cómo llegar</a>
          </div>
        </article>
      ))}
    </div>

    <div
      id="mapaSedes"
      class="mapa"
      data-sedes={JSON.stringify(
        config.sedes.map((sede) => ({
          id: sede.id,
          nombre: sede.nombre,
          direccion: sede.direccion,
          lat: sede.lat,
          lng: sede.lng,
        }))
      )}
    >
      <p class="mapa-cargando">El mapa se carga al llegar aquí…</p>
    </div>
    <p class="mapa-nota">Mapa de OpenStreetMap. Si no carga, las direcciones están arriba.</p>
  </div>
</Tienda>
