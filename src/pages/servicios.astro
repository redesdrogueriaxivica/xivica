---
import Tienda from "../layouts/Tienda.astro";
import Icono from "../components/Icono.astro";
import datos from "../datos/servicios.json";
import config from "../datos/config.json";

const mensajeFormula = encodeURIComponent(
  "Hola, quiero cotizar esta fórmula médica. Les envío la foto."
);
---
<Tienda
  titulo="Servicios"
  descripcion="Domicilio en 30 a 60 minutos, cotización de fórmulas médicas y recogida en sede."
  activa="servicios"
>
  <div class="container">
    <header class="catalogo-cabeza">
      <h1>Servicios</h1>
      <p>Lo que hacemos además de vender el producto.</p>
    </header>

    <div class="servicios">
      {datos.servicios.map((servicio) => (
        <article class="servicio" id={servicio.id}>
          <span class="servicio-icono"><Icono nombre={servicio.icono} tamano={24} /></span>
          <div>
            <h2>{servicio.titulo}</h2>
            <p class="servicio-resumen">{servicio.resumen}</p>
            <p class="servicio-detalle">{servicio.detalle}</p>
            <ul class="servicio-puntos">
              {servicio.puntos.map((punto) => <li>{punto}</li>)}
            </ul>
            {servicio.id === "formula" && (
              <a class="boton boton-lima" target="_blank" rel="noopener"
                 href={`https://wa.me/${config.whatsapp}?text=${mensajeFormula}`}>
                <Icono nombre="whatsapp" tamano={18} /> Enviar mi fórmula por WhatsApp
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</Tienda>
